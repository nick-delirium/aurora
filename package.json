{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Procedural, grainy gradient wallpapers for phones and desktops, sized to your exact screen.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "nick-delirium (https://github.com/nick-delirium)",
